{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/cards/**",
              "components/core/**",
              "components/layout/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant|Oswald|Poppins|Kalam))/i]",
        "message": "Font not provided by the design system. Available: Cormorant, Oswald, Poppins, Kalam."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmberCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|description|action|minHeight|key|ref|className|style|children)$/]",
        "message": "<AmberCard> doesn't accept that prop. Declared props: image, title, description, action, minHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|href|onClick|disabled|icon|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, href, onClick, disabled, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|width|align|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: color, width, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Divider> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GalleryGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:images|columns|gap|onSelect|key|ref|className|style|children)$/]",
        "message": "<GalleryGrid> doesn't accept that prop. Declared props: images, columns, gap, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|title|description|action|key|ref|className|style|children)$/]",
        "message": "<HeroSlide> doesn't accept that prop. Declared props: image, eyebrow, title, description, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|lines|tone|align|key|ref|className|style|children)$/]",
        "message": "<InfoBlock> doesn't accept that prop. Declared props: icon, label, lines, tone, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<InfoBlock> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<InfoBlock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|subtitle|height|overlay|key|ref|className|style|children)$/]",
        "message": "<PageHero> doesn't accept that prop. Declared props: image, title, subtitle, height, overlay."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|title|description|href|minHeight|padding|children|key|ref|className|style|children)$/]",
        "message": "<PhotoCard> doesn't accept that prop. Declared props: image, eyebrow, title, description, href, minHeight, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScrollTopButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:threshold|target|key|ref|className|style|children)$/]",
        "message": "<ScrollTopButton> doesn't accept that prop. Declared props: threshold, target."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|body|tone|align|eyebrowSize|children|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, body, tone, align, eyebrowSize, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark|amber)$/]",
        "message": "<SectionHeading> tone must be one of 'light' | 'dark' | 'amber'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:note|copyright|credit|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: note, copyright, credit."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRating'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|label|key|ref|className|style|children)$/]",
        "message": "<StarRating> doesn't accept that prop. Declared props: value, max, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|date|rating|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: quote, author, date, rating."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsappFab'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|message|tooltip|position|key|ref|className|style|children)$/]",
        "message": "<WhatsappFab> doesn't accept that prop. Declared props: phone, message, tooltip, position."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsappFab'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<WhatsappFab> position must be one of 'left' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
